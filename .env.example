# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# ISO date (YYYY-MM-DD) the challenge officially begins. Used only the
# first time the database is seeded.
CHALLENGE_START_DATE="2026-01-01"
